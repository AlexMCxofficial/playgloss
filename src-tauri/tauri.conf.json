{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlayGloss",
  "version": "0.1.1",
  "identifier": "io.github.alexmcxofficial.playgloss",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PlayGloss",
        "width": 560,
        "height": 920,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "English guess-the-meaning game for two players",
    "longDescription": "PlayGloss is a free, open-source English guess-the-meaning game for two teams. It works fully offline and collects no data.",
    "copyright": "Copyright (c) 2026 AlexMC",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": [
      "../CREDITS.md",
      "../LICENSE"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "android": {
      "versionCode": 1001
    }
  }
}
